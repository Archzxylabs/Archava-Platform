{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  // Root-level TypeScript (vitest.config.ts, tools/) has no package of its own
  // to be owned by, so the root tsconfig owns it. Packages are excluded: each
  // has its own tsconfig with the paths it needs, and `pnpm -r typecheck`
  // visits them all. The same holds for a workspace package under `tools/` —
  // `tools/configurator` declares its own `@archava/*` paths, and having the
  // root resolve them a second, different way would let the two disagree.
  "include": ["*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "packages", "apps", "tools/configurator"]
}

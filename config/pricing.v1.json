  "usage_definitions": {
    "active_conversation": "A customer session with at least one substantive Archava response, ending after 30 minutes of inactivity. Greetings-only sessions are not billable usage.",
    "realtime_minute": "One minute of active realtime voice session, metered to the nearest provider-supported increment.",
    "realtime_human_minute": "One minute with realtime avatar rendering enabled. If the avatar falls back to voice-only, the voice meter applies for that fallback period when technically measurable."
  },
  "commercial_rules": {
    "presence_setup_includes": ["one tenant/client configuration", "one standard embed target", "brand adaptation", "baseline knowledge ingestion", "page awareness instrumentation", "analytics events", "standard deployment configuration"],

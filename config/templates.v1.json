        "recommendations",
        "availability",
        "booking",
        "transactional_email",
        "handoff",
        "analytics"
      ],
      "common_integrations": ["PMS-or-booking-engine", "Postmark", "Midtrans-or-Stripe"]
    },
    "restaurant": {
      "label": "Restaurant / F&B",
      "default_environment": "commerce_booking",

  },
  "environment_definitions": {
    "existing_site": "Client already has a suitable production website. Archava is embedded and instrumented; remediation beyond a standard embed is separately scoped.",
    "landing": "One conversion-focused primary page plus legal/privacy essentials and lightweight content management where needed.",
    "business": "Approximately 2-8 primary marketing/content pages with CMS, forms, SEO foundations, analytics, and reusable design system.",
    "commerce_booking": "A conversion environment centered on catalog, product/service detail, booking or commerce flow, admin/content management, and transaction-ready integration points.",
    "custom_web_app": "Authenticated users, dashboards, multi-role workflows, custom data models, or application behavior beyond a standard marketing/commerce/booking environment.",
    "enterprise_system": "Complex multi-system, multi-entity, regulated, legacy-integrated, or dedicated-infrastructure implementation."
  },
  "presence_definitions": {
    "chat": "Text-based Archava with full Archava knowledge, page awareness, context, recommendations, supported actions, handoff, and analytics.",
    "voice": "Chat capabilities plus low-latency realtime spoken conversation and interruption/turn-taking.",
    "human": "Voice capabilities plus realtime human-looking avatar embodiment with graceful fallback to voice/chat."
  },
  "capability_definitions": {
    "assist": "Understand, answer, recommend, compare, navigate, capture leads, and hand off. No external state-changing business transaction is required.",
    "act": "Assist plus approved non-payment state-changing actions such as booking, form submission, CRM writes, sending transactional communications, or standard API actions.",
    "transact": "Act plus cart/order/checkout/payment/confirmation/receipt/post-purchase transaction orchestration.",
    "enterprise": "Complex ERP/legacy/multi-system workflows, dedicated infrastructure, advanced compliance, or business-critical custom orchestration."
  }
}

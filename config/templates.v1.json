{
  "schema_version": "1.0.0",
  "effective_date": "2026-09-22",
  "selection_rule": "Choose the closest primary industry template, then enable/disable modules to match the client. Do not invent a new template when an existing template plus modules fits.",
  "templates": {
    "generic_business": {
      "label": "Generic Business",
      "default_environment": "business",
      "recommended_presence": "voice",
      "recommended_capability": "act",
      "pages": ["home", "about", "services", "case-studies-or-portfolio", "faq", "contact"],
      "modules": ["knowledge", "page_awareness", "lead_capture", "forms", "handoff", "analytics"],
      "common_integrations": ["Postmark", "HubSpot-or-Pipedrive"]
    },
    "hospitality": {
      "label": "Hospitality / Hotel / Villa / Resort",
      "default_environment": "commerce_booking",

# ==========================================================================
# Archava Platform — local development environment template.
# Copy to `.env` (never commit `.env`). NEVER put real values in this file.
# All values below are placeholders / local-only defaults.
# ==========================================================================

# --- Node ---
NODE_ENV=development

# --- Tenant isolation (required even in single-tenant dev) ---------------
# Every request/context must carry a tenant id. There is no implicit
# "default" tenant by design, so a missing value must fail closed.
ARCHAVA_TENANT_ID=dev-tenant

# --- Reference client selection -----------------------------------------
# Which client configuration the reference site + configurator loads.
ARCHAVA_CLIENT_CONFIG=clients/generic-business/client.config.json

# --- Archava Web SDK (page awareness) ------------------------------------
# URL of the Archava experience host that receives page context.
# Leave empty in local dev: the SDK then runs in local-only mode and never
# leaks page data to an external destination.
ARCHAVA_SDK_ENDPOINT=

# --- Realtime AI provider ------------------------------------------------
# Assisted greeting text on the reference site is rendered server-side.
# When ARCHAVA_AI_PROVIDER=mock the deterministic assistant is used and no
# credentials are needed. Production paths fail closed if a provider is
# selected but its credentials are missing.
ARCHAVA_AI_PROVIDER=mock

# --- LiveKit (only used when ARCHAVA_PRESENCE_PROVIDER=livekit) ----------
# LiveKit is a commodity transport provider behind an explicit adapter.
# The mock provider used in this slice needs none of these.
ARCHAVA_PRESENCE_PROVIDER=mock
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Realtime model provider (Gemini Live adapter) ------------------------
ARCHAVA_MODEL_PROVIDER=mock
GOOGLE_API_KEY=

# --- Avatar provider (Spatius default, behind adapter) -------------------
ARCHAVA_AVATAR_PROVIDER=mock
SPATIUS_API_KEY=

# --- Transactional email (Postmark default adapter) ----------------------
ARCHAVA_EMAIL_PROVIDER=mock
POSTMARK_API_KEY=

# --- Analytics (PostHog-compatible) --------------------------------------
# Only a public/write key belongs in a browser bundle. Never put a secret
# key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Object storage / cache (S3/R2, Redis-compatible) --------------------
# Interfaces only in this slice; no provider is installed yet.
ARCHAVA_STORAGE_PROVIDER=mock
ARCHAVA_CACHE_PROVIDER=mock

# --- Observability (Sentry / OpenTelemetry) ------------------------------
ARCHAVA_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

{
  "name": "@archava/act-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL-backed attempt stores for the Act booking and email replay boundaries.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/act-storage/test",
    "verify:sql": "tsx scripts/verify-against-postgres.ts"
  },
  "dependencies": {
    "@archava/act-booking": "workspace:*",
    "@archava/act-email": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

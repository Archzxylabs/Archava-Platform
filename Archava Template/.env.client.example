# Client profile: blank credentials; personal profile is never loaded.
# Server and worker only. Never put secrets in VITE_* or config/project.json.
PORT=5002
WEB_ORIGIN=http://localhost:5174
# Use a different ID for every project AND environment sharing LiveKit.
PROJECT_ID=archava-template-dev
# Empty = <PROJECT_ID>-host. API and worker must use the same name.
ARCHAVA_AGENT_NAME=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
# Baseline model inherited from Archava; verify availability in your account.
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Kore
# spatius | tavus | voice
AVATAR_PROVIDER=spatius
SPATIUS_API_KEY=
SPATIUS_APP_ID=
SPATIUS_AVATAR_ID=
TAVUS_API_KEY=
FACE_ID=
PAL_ID=
# Public sessions stay off until credentials and the worker have been tested.
ENABLE_SESSIONS=false
SESSION_SECONDS=120
MAX_ACTIVE_SESSIONS=10
SESSION_STARTS_PER_MINUTE=3
# Off by default. Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Public build variable. Empty = same-origin /api (local proxy or single server).
# For Vercel + Railway set this to your public backend HTTPS origin, without /api.
VITE_API_BASE_URL=
